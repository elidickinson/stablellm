# Bind-time server settings (changing these requires a restart).
HOST=0.0.0.0
PORT=4000
REQUEST_TIMEOUT=120
CONNECT_TIMEOUT=4

# Optional: require this key from clients connecting to the proxy.
# API_KEY=my-proxy-secret

# Path to the YAML config (endpoints, groups, runtime settings).
# CONFIG_FILE=config.yaml

# Optional: enable the web config editor at /config/editor.
# CONFIG_EDITOR_PASSWORD=change-me

# API keys referenced from config.yaml via ${VAR} interpolation.
OPENAI_API_KEY=sk-your-key-here
# OPENAI_BACKUP_KEY=
# CEREBRAS_API_KEY=
# OPENROUTER_API_KEY=

# --- Live integration tests (opt-in) ---
# Set STABLELLM_LIVE_TESTS=1 and all three LIVE_TEST_* vars to enable tests/test_live.py.
# These make real API calls through the proxy against the configured upstream.
# STABLELLM_LIVE_TESTS=1
# LIVE_TEST_BASE_URL=https://api.cerebras.ai/v1
# LIVE_TEST_API_KEY=csk-...
# LIVE_TEST_MODEL=zai-glm-4.7
